# Пример конфигурации. Скопируйте в .env и заполните своими значениями.
# НЕ коммитьте реальный .env.

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE

# Строка подключения к PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://shiftbot:shiftbot@localhost:5432/shiftbot

# Telegram ID администраторов через запятую
ADMIN_IDS=111111111,222222222

# Часовой пояс
TIMEZONE=Europe/Vilnius
